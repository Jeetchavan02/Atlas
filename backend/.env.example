PORT=4000
MONGODB_URI=mongodb://localhost:27017/atlas-luxe
CORS_ORIGIN=http://localhost:5173
# Groq API (High-speed LPU cloud inference — keys start with gsk_)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# xAI / Grok API (Optional alternative — keys start with xai-)
GROK_API_KEY=xai-your_grok_api_key_here
GROK_MODEL=grok-beta

# Local Ollama AI (optional fallback / offline provider)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:latest

# Gmail mock poller (milliseconds, default 5 min)
GMAIL_POLL_INTERVAL_MS=300000

# Zepp / Amazfit Bip 6 mock sync
# Set to "true" to enable the Amazfit Bip 6 circadian simulator
ZEPP_MOCK_ENABLED=true
# Sync interval in milliseconds (default 15 min)
ZEPP_SYNC_INTERVAL_MS=900000

# Terra API (optional — for real Zepp cloud integration)
# TERRA_DEV_ID=your_terra_dev_id
# TERRA_API_KEY=your_terra_api_key
